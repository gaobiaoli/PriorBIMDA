"""PriorDA-style metric refinement with a DAv2-relative DINOv2--DPT.

The metric coordinate frame is defined only by valid BIM depth. DA3 metric
depth and BIM depth are transformed into that shared frame and represented as
normalized disparity. The DPT output is one dense normalized-disparity map;
there is no scale head, coarse stage, residual head, or auxiliary prediction.
"""
from __future__ import annotations

from collections.abc import Mapping

import torch
import torch.nn.functional as F

from .bim_early_fusion_dav2 import BIMEarlyFusionDepthAnythingV2


def depth2disparity(depth: torch.Tensor) -> torch.Tensor:
    """Exact PriorDA convention: reciprocal where depth > 0, otherwise zero."""

    disparity = torch.zeros_like(depth)
    positive = depth > 0
    disparity[positive] = depth[positive].reciprocal()
    return disparity


def bim_affine_frame(
    bim_depth: torch.Tensor,
    bim_valid: torch.Tensor,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    """Return valid BIM mask, per-frame minimum, and per-frame range."""

    if bim_depth.ndim != 4 or bim_depth.shape[1] != 1 or bim_depth.shape != bim_valid.shape:
        raise ValueError("BIM depth/mask must have matching [B,1,H,W] shapes")
    valid = (bim_valid > 0.5) & torch.isfinite(bim_depth) & (bim_depth > 0)
    support = valid.flatten(1).sum(dim=1)
    if bool((support == 0).any()):
        raise ValueError("PriorDA shared affine normalization requires valid BIM support in every frame")
    minimum = bim_depth.masked_fill(~valid, torch.inf).amin(dim=(-2, -1), keepdim=True)
    maximum = bim_depth.masked_fill(~valid, -torch.inf).amax(dim=(-2, -1), keepdim=True)
    value_range = maximum - minimum
    value_range = torch.where(value_range == 0, torch.ones_like(value_range), value_range)
    if not bool((torch.isfinite(minimum) & torch.isfinite(value_range) & (value_range > 0)).all()):
        raise FloatingPointError("Invalid BIM-only affine normalization frame")
    return valid, minimum, value_range


def build_priorda_relative_condition(
    batch: Mapping[str, torch.Tensor],
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    """Build [q_DA3, q_BIM, M_BIM] in the one shared BIM affine frame."""

    base = batch["base_depth"].float()
    bim = batch["bim_depth"].float()
    mask = batch["bim_valid"].float()
    if base.ndim != 4 or base.shape[1] != 1 or base.shape != bim.shape:
        raise ValueError("DA3 and BIM depth must have matching [B,1,H,W] shapes")
    if not bool((torch.isfinite(base) & (base > 0)).all()):
        raise ValueError("Metric DA3 must be dense, positive and finite")
    valid, minimum, value_range = bim_affine_frame(bim, mask)
    normalized_base = (base - minimum) / value_range
    normalized_bim = torch.where(valid, (bim - minimum) / value_range, torch.zeros_like(bim))
    q_base = depth2disparity(normalized_base)
    q_bim = depth2disparity(normalized_bim)
    condition = torch.cat((q_base, q_bim, valid.float()), dim=1)
    if not bool(torch.isfinite(condition).all()):
        raise FloatingPointError("Nonfinite PriorDA normalized-disparity condition")
    return condition, minimum, value_range


class PriorDARelativeMetricRefiner(BIMEarlyFusionDepthAnythingV2):
    """DAv2-relative conditioned DPT whose sole output is metric depth."""

    CONDITION_CHANNELS = 3
    ARCHITECTURE = "dav2_relative_priorda_bim_affine_metric_refiner"

    def __init__(self, pretrained_model) -> None:
        super().__init__(pretrained_model)
        if self.depth_estimation_type != "relative":
            raise ValueError("PriorDA metric refiner requires the official DAv2-relative checkpoint")

    def forward(self, rgb, bim_condition=None):
        # Tensor interface is retained for the inherited zero-init audit.
        if not isinstance(rgb, Mapping):
            return super().forward(rgb, bim_condition)
        batch = rgb
        condition, minimum, value_range = build_priorda_relative_condition(batch)
        normalized_disparity = super().forward(batch["rgb"], condition)[:, None].float()
        normalized_depth = depth2disparity(normalized_disparity)
        depth = normalized_depth * value_range + minimum
        if not bool((torch.isfinite(depth) & (depth > 0)).all()):
            raise FloatingPointError("Invalid de-normalized metric depth")
        return {
            "depth": depth,
            "normalized_disparity": normalized_disparity,
            "normalized_depth": normalized_depth,
            "bim_minimum": minimum,
            "bim_range": value_range,
        }


def bim_zero_anchor_scale(
    bim_depth: torch.Tensor,
    bim_valid: torch.Tensor,
) -> tuple[torch.Tensor, torch.Tensor]:
    """Return the valid BIM mask and its positive per-frame maximum depth.

    Physical zero, rather than the nearest BIM surface, is the depth origin.
    Consequently every finite positive metric depth remains positive after
    normalization, including depths nearer than the BIM minimum.
    """

    if bim_depth.ndim != 4 or bim_depth.shape[1] != 1 or bim_depth.shape != bim_valid.shape:
        raise ValueError("BIM depth/mask must have matching [B,1,H,W] shapes")
    valid = (bim_valid > 0.5) & torch.isfinite(bim_depth) & (bim_depth > 0)
    support = valid.flatten(1).sum(dim=1)
    if bool((support == 0).any()):
        raise ValueError("BIM zero-anchor normalization requires valid BIM support in every frame")
    scale = bim_depth.masked_fill(~valid, -torch.inf).amax(dim=(-2, -1), keepdim=True)
    if not bool((torch.isfinite(scale) & (scale > 0)).all()):
        raise FloatingPointError("Invalid BIM maximum-depth scale")
    return valid, scale


def build_priorda_zero_anchor_condition(
    batch: Mapping[str, torch.Tensor],
) -> tuple[torch.Tensor, torch.Tensor]:
    """Build lossless-positive [Dmax/Draw, Dmax/DBIM, M_BIM]."""

    base = batch["base_depth"].float()
    bim = batch["bim_depth"].float()
    mask = batch["bim_valid"].float()
    if base.ndim != 4 or base.shape[1] != 1 or base.shape != bim.shape:
        raise ValueError("DA3 and BIM depth must have matching [B,1,H,W] shapes")
    if not bool((torch.isfinite(base) & (base > 0)).all()):
        raise ValueError("Metric DA3 must be dense, positive and finite")
    valid, scale = bim_zero_anchor_scale(bim, mask)
    normalized_base = base / scale
    normalized_bim = torch.where(valid, bim / scale, torch.zeros_like(bim))
    q_base = depth2disparity(normalized_base)
    q_bim = depth2disparity(normalized_bim)
    condition = torch.cat((q_base, q_bim, valid.float()), dim=1)
    if not bool(torch.isfinite(condition).all()):
        raise FloatingPointError("Nonfinite zero-anchor normalized-disparity condition")
    return condition, scale


class PriorDARelativeZeroAnchorMetricRefiner(BIMEarlyFusionDepthAnythingV2):
    """DAv2-relative refiner with a BIM-scaled, zero-origin depth frame.

    D / Dmax is positive and one-to-one over every positive metric depth, so
    neither the condition nor output has a BIM-min representational floor. The
    final hard ReLU is replaced by a steep Softplus to keep disparity strictly
    positive and differentiable while preserving all pretrained head weights.
    """

    CONDITION_CHANNELS = 3
    ARCHITECTURE = "dav2_relative_priorda_bim_zero_anchor_softplus10_metric_refiner"

    def __init__(self, pretrained_model) -> None:
        super().__init__(pretrained_model)
        self.dav2.head.activation2 = torch.nn.Softplus(beta=10.0, threshold=20.0)
        if self.depth_estimation_type != "relative":
            raise ValueError("PriorDA zero-anchor refiner requires the official DAv2-relative checkpoint")


    def initialization_audit(self, **kwargs):
        result = super().initialization_audit(**kwargs)
        result["early_equals_pretrained_dav2"]["reference_note"] = (
            "pretrained DAv2 weights with configured Softplus replacing only final ReLU"
        )
        result["output_activation"] = {
            "pass": isinstance(self.dav2.head.activation2, torch.nn.Softplus),
            "official_activation": "ReLU",
            "configured_activation": "Softplus(beta=10, threshold=20)",
            "reason": "strictly positive differentiable disparity without a metric-depth floor",
        }
        result["all_pass"] = all(bool(value["pass"]) for key, value in result.items() if key != "all_pass")
        return result
    def forward(self, rgb, bim_condition=None):
        if not isinstance(rgb, Mapping):
            return super().forward(rgb, bim_condition)
        batch = rgb
        condition, scale = build_priorda_zero_anchor_condition(batch)
        normalized_disparity = super().forward(batch["rgb"], condition)[:, None].float()
        normalized_depth = depth2disparity(normalized_disparity)
        depth = normalized_depth * scale
        if not bool((torch.isfinite(depth) & (depth > 0)).all()):
            raise FloatingPointError("Invalid zero-anchor metric depth")
        return {
            "depth": depth,
            "normalized_disparity": normalized_disparity,
            "normalized_depth": normalized_depth,
            "bim_scale": scale,
        }


def prior_affine_frame(prior_depth: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
    """Return dense-prior per-frame minimum and safe range."""

    if prior_depth.ndim != 4 or prior_depth.shape[1] != 1:
        raise ValueError("Prior metric depth must have shape [B,1,H,W]")
    if not bool((torch.isfinite(prior_depth) & (prior_depth > 0)).all()):
        raise ValueError("Prior metric depth must be dense, positive and finite")
    minimum = prior_depth.amin(dim=(-2, -1), keepdim=True)
    maximum = prior_depth.amax(dim=(-2, -1), keepdim=True)
    value_range = maximum - minimum
    value_range = torch.where(value_range == 0, torch.ones_like(value_range), value_range)
    return minimum, value_range


def build_prior_identity_condition(
    batch: Mapping[str, torch.Tensor],
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
    """Build [q_prior^N, q_BIM^N, M_BIM] in the prior-defined affine frame."""

    prior = batch["base_depth"].float()
    bim = batch["bim_depth"].float()
    mask = batch["bim_valid"].float()
    if prior.shape != bim.shape or prior.shape != mask.shape:
        raise ValueError("Prior/BIM/mask must have matching [B,1,H,W] shapes")
    minimum, value_range = prior_affine_frame(prior)
    valid = (mask > 0.5) & torch.isfinite(bim) & (bim > 0)
    normalized_prior = (prior - minimum) / value_range
    normalized_bim = torch.where(
        valid,
        (bim - minimum) / value_range,
        torch.zeros_like(bim),
    )
    q_prior = depth2disparity(normalized_prior)
    q_bim = depth2disparity(normalized_bim)
    condition = torch.cat((q_prior, q_bim, valid.float()), dim=1)
    if not bool(torch.isfinite(condition).all()):
        raise FloatingPointError("Nonfinite prior-normalized disparity condition")
    return condition, minimum, value_range, q_prior


def fit_disparity_affine(
    relative_disparity: torch.Tensor,
    prior_depth: torch.Tensor,
) -> tuple[torch.Tensor, torch.Tensor]:
    """Least-squares fit 1/D_prior = a*q_relative+b independently per frame."""

    if relative_disparity.shape != prior_depth.shape:
        raise ValueError("Relative disparity and prior depth must have identical shapes")
    x = relative_disparity.float().flatten(1)
    y = prior_depth.float().reciprocal().flatten(1)
    x_mean = x.mean(dim=1, keepdim=True)
    y_mean = y.mean(dim=1, keepdim=True)
    centered = x - x_mean
    denominator = centered.square().sum(dim=1, keepdim=True)
    safe_denominator = torch.where(denominator > 0, denominator, torch.ones_like(denominator))
    slope = (centered * (y - y_mean)).sum(dim=1, keepdim=True) / safe_denominator
    slope = torch.where(denominator > 0, slope, torch.zeros_like(slope))
    intercept = y_mean - slope * x_mean
    shape = (-1, 1, 1, 1)
    return slope.reshape(shape), intercept.reshape(shape)


def transform_relative_to_prior_normalized_disparity(
    relative_disparity: torch.Tensor,
    prior_depth: torch.Tensor,
    minimum: torch.Tensor,
    value_range: torch.Tensor,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    """Apply the proposed calibration->metric-depth->normalization map T."""

    slope, intercept = fit_disparity_affine(relative_disparity, prior_depth)
    metric_disparity = slope * relative_disparity + intercept
    calibrated_depth = depth2disparity(metric_disparity)
    normalized_depth = (calibrated_depth - minimum) / value_range
    transformed = depth2disparity(normalized_depth)
    if not bool(torch.isfinite(transformed).all()):
        raise FloatingPointError("Nonfinite calibrated prior-normalized disparity")
    return transformed, slope, intercept


class PriorDARelativePriorIdentityMetricRefiner(BIMEarlyFusionDepthAnythingV2):
    """Prior-normalized DAv2 refiner with an exact metric identity at step zero.

    The pretrained relative output q_theta and the proposed affine calibration
    map T are retained as signals. A zero-initialized dense head predicts a
    bounded log-disparity correction around q_prior^N, so the metric output is
    exactly D_prior before any optimizer update without assuming two different
    depth models are related by a pointwise two-parameter transform.
    """

    CONDITION_CHANNELS = 3
    ARCHITECTURE = "dav2_relative_prior_normalized_exact_prior_identity"
    MAX_LOG_DISPARITY_RESIDUAL = 0.7

    def __init__(self, pretrained_model) -> None:
        super().__init__(pretrained_model)
        if self.depth_estimation_type != "relative":
            raise ValueError("Prior identity refiner requires the official DAv2-relative checkpoint")
        head_channels = int(self.dav2.config.head_hidden_size)
        self.prior_identity_head = torch.nn.Conv2d(head_channels + 3, 1, kernel_size=1)
        torch.nn.init.zeros_(self.prior_identity_head.weight)
        torch.nn.init.zeros_(self.prior_identity_head.bias)

    def _relative_output_and_features(
        self,
        rgb: torch.Tensor,
        condition: torch.Tensor,
    ) -> tuple[torch.Tensor, torch.Tensor]:
        normalized = self.normalized_rgb(rgb)
        embeddings = self._early_embeddings(normalized, condition)
        neck, patch_height, patch_width = self._neck_embeddings(
            embeddings,
            height=normalized.shape[-2],
            width=normalized.shape[-1],
        )
        head = self.dav2.head
        features = head.conv1(neck[head.head_in_index])
        features = F.interpolate(
            features,
            (int(patch_height * head.patch_size), int(patch_width * head.patch_size)),
            mode="bilinear",
            align_corners=True,
        )
        features = head.activation1(head.conv2(features))
        relative = head.activation2(head.conv3(features)) * head.max_depth
        return relative, features

    def forward(self, rgb, bim_condition=None):
        if not isinstance(rgb, Mapping):
            return super().forward(rgb, bim_condition)
        batch = rgb
        prior = batch["base_depth"].float()
        condition, minimum, value_range, q_prior = build_prior_identity_condition(batch)
        relative, features = self._relative_output_and_features(batch["rgb"], condition)
        relative = relative.float()
        transformed, slope, intercept = transform_relative_to_prior_normalized_disparity(
            relative.detach(), prior, minimum, value_range
        )
        correction_input = torch.cat(
            (
                features,
                relative.to(dtype=features.dtype),
                transformed.to(dtype=features.dtype),
                q_prior.to(dtype=features.dtype),
            ),
            dim=1,
        )
        correction_logits = self.prior_identity_head(correction_input).float()
        log_disparity_residual = self.MAX_LOG_DISPARITY_RESIDUAL * torch.tanh(correction_logits)
        q_output = q_prior * torch.exp(log_disparity_residual)
        normalized_depth = depth2disparity(q_output)
        reconstructed = minimum + value_range * normalized_depth
        # Makes the initialization contract bit-exact, not merely allclose.
        depth = torch.where(log_disparity_residual == 0, prior, reconstructed)
        if not bool((torch.isfinite(depth) & (depth > 0)).all()):
            raise FloatingPointError("Invalid prior-identity metric depth")
        return {
            "depth": depth,
            "relative_disparity": relative,
            "transformed_disparity": transformed,
            "prior_normalized_disparity": q_prior,
            "output_normalized_disparity": q_output,
            "log_disparity_residual": log_disparity_residual,
            "prior_minimum": minimum,
            "prior_range": value_range,
            "calibration_slope": slope,
            "calibration_intercept": intercept,
        }

    def optimizer_parameter_groups(self, *, encoder_lr, decoder_lr, condition_lr):
        groups = [
            {"name": "dinov2_encoder", "params": list(self.dav2.backbone.parameters()), "lr": encoder_lr},
            {"name": "dpt_decoder", "params": [*self.dav2.neck.parameters(), *self.dav2.head.parameters()], "lr": decoder_lr},
            {"name": "condition_and_identity", "params": [*self.bim_condition_embed.parameters(), *self.prior_identity_head.parameters()], "lr": condition_lr},
        ]
        parameter_ids = [id(parameter) for group in groups for parameter in group["params"]]
        if len(parameter_ids) != len(set(parameter_ids)):
            raise RuntimeError("Optimizer parameter groups overlap")
        if set(parameter_ids) != {id(parameter) for parameter in self.parameters()}:
            raise RuntimeError("Optimizer parameter groups do not cover the full prior-identity model")
        return groups

    def initialization_audit(self, **kwargs):
        result = super().initialization_audit(**kwargs)
        weight = self.prior_identity_head.weight.detach()
        bias = self.prior_identity_head.bias.detach()
